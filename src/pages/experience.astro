---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Experience"
	description="Francisco Abajo Lis's experience in software validation, teaching, course support, and student guidance."
	showHeader={false}
>
	<header class="mb-14 max-w-3xl sm:mb-20">
		<p class="mb-3 text-xs font-medium tracking-[0.18em] uppercase opacity-60">Background</p>
		<h1 class="font-serif text-4xl leading-tight sm:text-6xl">Experience</h1>
		<p class="mt-6 text-lg leading-relaxed opacity-75 sm:text-xl">
			Engineering practice, teaching, and student-facing work across technical and international environments.
		</p>
	</header>

	<section class="mb-20 sm:mb-28" aria-labelledby="experience-heading">
		<h2 id="experience-heading" class="mb-8 font-serif text-3xl sm:text-4xl">Experience</h2>
		<div class="grid gap-6 lg:grid-cols-2">
			<article class="experience-card rounded-3xl border border-main/15 bg-muted p-7 sm:p-9 lg:col-span-2">
				<div class="grid gap-8 md:grid-cols-[12rem_1fr] md:items-start">
					<div class="brand-tile flex min-h-32 items-center justify-center rounded-2xl bg-white p-6">
						<img class="h-auto w-full max-w-40" src="/brands/asml.svg" alt="ASML" />
					</div>
					<div>
						<p class="text-sm font-medium tracking-wide text-[color:var(--accent)]">September 2025–March 2026 · Veldhoven</p>
						<h3 class="mt-2 font-serif text-3xl">Software Engineer Intern</h3>
						<p class="mt-4 max-w-3xl leading-relaxed opacity-80">
							Improved the maintainability, reliability, and efficiency of Python-supported software-validation workflows for critical EUV functionality in a digital-twin environment.
						</p>
						<ul class="mt-6 grid gap-3 text-sm leading-relaxed sm:grid-cols-2 sm:text-base">
							<li>Python and Robot Framework validation</li>
							<li>Approximately 70% less Python code</li>
							<li>Approximately 45% simpler test-suite structure</li>
							<li>Digital-twin restarts reduced by about two-thirds</li>
						</ul>
					</div>
				</div>
			</article>

			<article class="experience-card rounded-3xl border border-main/15 bg-muted p-7 sm:p-9 lg:col-span-2">
				<div class="grid gap-8 md:grid-cols-[12rem_1fr] md:items-start">
					<div>
						<div class="brand-tile flex min-h-32 items-center justify-center rounded-2xl bg-white p-6">
							<img class="h-auto w-full max-w-52" src="/brands/tue.svg" alt="Eindhoven University of Technology" />
						</div>
						<p class="mt-4 text-sm font-medium tracking-wide text-[color:var(--accent)]">2024–2026 · Eindhoven</p>
					</div>
					<div>
						<p class="text-xs font-medium tracking-[0.16em] uppercase opacity-60">Eindhoven University of Technology</p>
						<h3 class="mt-2 font-serif text-3xl">Teaching &amp; Course Support</h3>
						<div class="mt-7 grid gap-4 sm:grid-cols-2">
							<section class="role-detail rounded-2xl border border-main/10 bg-main/55 p-5">
								<h4 class="font-serif text-xl">Calculus I Tutor</h4>
								<p class="mt-2 text-sm leading-relaxed opacity-75">
									Mentored two groups of pre-master's students in Calculus I, providing weekly instruction and correcting their homework and exams.
								</p>
							</section>
							<section class="role-detail rounded-2xl border border-main/10 bg-main/55 p-5">
								<h4 class="font-serif text-xl">Course Assistant</h4>
								<p class="mt-2 text-sm leading-relaxed opacity-75">
									Helped improve the new Applied Physics course Physics of Transport Phenomena (32PTP) by providing feedback in meetings with professors and through written reports.
								</p>
							</section>
							<section class="role-detail rounded-2xl border border-main/10 bg-main/55 p-5">
								<h4 class="font-serif text-xl">Thermodynamics Teaching Assistant</h4>
								<p class="mt-2 text-sm leading-relaxed opacity-75">
									Mentored second-year Applied Physics students throughout the main Thermodynamics course project.
								</p>
							</section>
							<section class="role-detail rounded-2xl border border-main/10 bg-main/55 p-5">
								<h4 class="font-serif text-xl">Regression Models Teaching Assistant</h4>
								<p class="mt-2 text-sm leading-relaxed opacity-75">
									Supported students during instruction sessions with regression theory and an applied project in R.
								</p>
							</section>
						</div>
					</div>
				</div>
			</article>

			<article class="experience-card rounded-3xl border border-main/15 bg-muted p-7 sm:p-9 lg:col-span-2">
				<div class="grid gap-8 md:grid-cols-[12rem_1fr] md:items-center">
					<div class="flex min-h-28 items-center justify-center rounded-2xl border border-main/10 bg-main p-6">
						<span class="font-serif text-3xl italic text-[color:var(--accent)]">Unibuddy</span>
					</div>
					<div>
						<p class="text-sm font-medium tracking-wide text-[color:var(--accent)]">September 2024–June 2026</p>
						<h3 class="mt-2 font-serif text-3xl">Student Ambassador</h3>
						<p class="mt-4 max-w-3xl leading-relaxed opacity-80">
							Spoke with prospective students through Unibuddy, providing information about TU/e, programme-specific guidance, and answers about student life.
						</p>
					</div>
				</div>
			</article>
		</div>
	</section>

	<section class="rounded-3xl border border-main/15 px-7 py-9 sm:px-10" aria-labelledby="interests-heading">
		<p class="mb-3 text-xs font-medium tracking-[0.18em] uppercase opacity-60">Next step</p>
		<h2 id="interests-heading" class="font-serif text-3xl sm:text-4xl">Where I want to contribute</h2>
		<p class="mt-5 max-w-4xl text-lg leading-relaxed opacity-80">
			Quantitative analysis · Data · Modelling · Optimisation · Risk · AI-enabled tools · Technical automation
		</p>
	</section>
</BaseLayout>

<style>
	.experience-card {
		box-shadow: 0 18px 50px color-mix(in srgb, var(--text-main) 7%, transparent);
	}

	.brand-tile img {
		max-height: 5rem;
	}
</style>
